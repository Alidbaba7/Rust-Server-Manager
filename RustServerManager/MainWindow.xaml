<ui:FluentWindow x:Class="RustServerManager.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Rust Server Manager" Height="750" Width="1050" 
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource RustDarkBg}"
                 Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="RUST SERVER MANAGER" ShowMaximize="True" ShowMinimize="True" />

        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="10,0,10,10" Background="Transparent" BorderThickness="0">

            <!-- ВКЛАДКА: МОНИТОРИНГ -->
            <TabItem Header="Мониторинг">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="16" Height="16" Fill="#dc3545" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusText" Text="Сервер выключен" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
                        <Border Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Margin="0,0,5,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Загрузка CPU" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="CpuStat" Text="0%" Foreground="{DynamicResource RustOrange}" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Margin="5,0,5,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Использование RAM" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="RamStat" Text="0 MB" Foreground="{DynamicResource RustOrange}" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Margin="5,0,5,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Время работы" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="UptimeStat" Text="00:00:00" Foreground="{DynamicResource RustOrange}" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Margin="5,0,0,0" Padding="15">
                            <StackPanel>
                                <TextBlock Text="Игроков онлайн" Foreground="#888" FontSize="12"/>
                                <TextBlock x:Name="PlayersStat" Text="0" Foreground="#28a745" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                        <ui:Button Content="Запустить сервер" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Width="180" Height="40" Margin="0,0,10,0" Click="StartServer_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                        <ui:Button Content="Остановить сервер" Icon="{ui:SymbolIcon Stop24}" Appearance="Primary" Width="180" Height="40" Margin="0,0,10,0" Click="StopServer_Click" Background="#dc3545" Foreground="Black"/>
                        <ui:Button Content="Обновить сервер" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Width="180" Height="40" Click="UpdateServer_Click" Background="#17a2b8" Foreground="Black"/>
                    </StackPanel>

                    <Border Grid.Row="3" Background="{DynamicResource RustConsoleBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                        <TextBox x:Name="ConsoleOutput" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Background="Transparent" Foreground="#A9B7C6" BorderThickness="0" TextWrapping="Wrap" Padding="10"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА: УТИЛИТЫ (БЭКАПЫ И ВАЙП) -->
            <TabItem Header="Утилиты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Блок Бэкапов -->
                    <Border Grid.Row="0" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="💾 Бэкапы сервера" Foreground="{DynamicResource RustOrange}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Создает ZIP-архив папки server (карты, постройки) и oxide (плагины, конфиги)." Foreground="#AAA" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Сделать бэкап" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Width="180" Height="40" Click="CreateBackup_Click" Background="#28a745" Foreground="Black" Margin="0,0,15,0"/>
                                <ui:Button Content="Открыть папку бэкапов" Icon="{ui:SymbolIcon FolderOpen24}" Width="220" Height="40" Click="OpenBackupFolder_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Блок Вайпа -->
                    <Border Grid.Row="1" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="20" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="☢️ Управление вайпом" Foreground="#dc3545" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Удаляет файлы карты (.map) и сохранения (.sav). Плагины и настройки останутся на месте." Foreground="#AAA" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Вайп карты и сейвов" Icon="{ui:SymbolIcon Delete24}" Appearance="Primary" Width="220" Height="40" Click="WipeServer_Click" Background="#dc3545" Foreground="Black" Margin="0,0,15,0"/>
                                <ui:Button Content="Вайп чертежей (Blueprints)" Icon="{ui:SymbolIcon Delete24}" Width="240" Height="40" Click="WipeBlueprints_Click" Background="#dc3545" Foreground="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Блок Быстрых RCON команд -->
                    <Border Grid.Row="2" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="20">
                        <StackPanel>
                            <TextBlock Text="⚡ Быстрые команды (RCON)" Foreground="#17a2b8" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Требует подключения к RCON во вкладке 'RCON / Игроки'." Foreground="#AAA" Margin="0,0,0,15" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Сохранить мир" Icon="{ui:SymbolIcon Save24}" Width="150" Height="40" Click="QuickSave_Click" Background="#17a2b8" Foreground="Black" Margin="0,0,10,0"/>
                                <ui:Button Content="Перезагрузить Oxide" Icon="{ui:SymbolIcon ArrowSync24}" Width="180" Height="40" Click="QuickReloadOxide_Click" Background="#17a2b8" Foreground="Black" Margin="0,0,10,0"/>
                                <ui:Button Content="Написать в чат" Icon="{ui:SymbolIcon Chat24}" Width="150" Height="40" Click="QuickBroadcast_Click" Background="#17a2b8" Foreground="Black"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА: НАСТРОЙКИ -->
            <TabItem Header="Настройки">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Папка с сервером:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}"/>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtServerPath" Grid.Column="0" Width="300" HorizontalAlignment="Left"/>
                        <ui:Button Grid.Column="1" Content="Выбрать" Click="BrowseServer_Click" Margin="10,0,0,0" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Название сервера:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}"/>
                    <ui:TextBox x:Name="TxtServerName" Grid.Row="1" Grid.Column="1" Width="400" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Макс. игроков:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}"/>
                    <ui:TextBox x:Name="TxtMaxPlayers" Grid.Row="2" Grid.Column="1" Width="400" HorizontalAlignment="Left" Text="50"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Размер карты:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}"/>
                    <ui:TextBox x:Name="TxtWorldSize" Grid.Row="3" Grid.Column="1" Width="400" HorizontalAlignment="Left" Text="3000"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Сид карты (Seed):" VerticalAlignment="Center" Foreground="{DynamicResource RustText}"/>
                    <ui:TextBox x:Name="TxtServerSeed" Grid.Row="4" Grid.Column="1" Width="400" HorizontalAlignment="Left" Text="1337"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Пароль RCON:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}"/>
                    <ui:TextBox x:Name="TxtRconPassword" Grid.Row="5" Grid.Column="1" Width="400" HorizontalAlignment="Left" Text="SuperSecret123!"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text="Дополнительные команды:" Margin="0,15,0,5" FontWeight="SemiBold" Foreground="{DynamicResource RustOrange}"/>
                    <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Width="620" Height="140" HorizontalAlignment="Left" Background="{DynamicResource RustConsoleBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                        <TextBox x:Name="TxtCustomCommands" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A9B7C6" BorderThickness="0" FontFamily="Consolas" Padding="10"/>
                    </Border>

                    <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,15,0,0">
                        <ui:Button Content="Сохранить настройки" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Width="220" Height="40" Margin="0,0,15,0" Click="SaveSettings_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                        <ui:Button Content="Открыть папку конфигов" Icon="{ui:SymbolIcon Folder24}" Width="220" Height="40" Click="OpenConfigFolder_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА: RCON / ИГРОКИ -->
            <TabItem Header="RCON / Игроки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0,0,0,10" Padding="10" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IP:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}" Margin="0,0,5,0"/>
                            <ui:TextBox x:Name="TxtRconIp" Text="127.0.0.1" Width="120" Margin="0,0,10,0"/>
                            <TextBlock Text="Порт:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}" Margin="0,0,5,0"/>
                            <ui:TextBox x:Name="TxtRconPort" Text="28016" Width="80" Margin="0,0,10,0"/>
                            <TextBlock Text="Пароль:" VerticalAlignment="Center" Foreground="{DynamicResource RustText}" Margin="0,0,5,0"/>
                            <ui:PasswordBox x:Name="TxtRconPass" Width="150" Margin="0,0,15,0"/>
                            <ui:Button Content="Подключиться" Icon="{ui:SymbolIcon PlugConnected24}" Appearance="Primary" Background="{DynamicResource RustOrange}" Foreground="Black" Click="ConnectRcon_Click" Margin="0,0,10,0"/>
                            <ui:Button Content="Обновить список" Icon="{ui:SymbolIcon ArrowSync24}" Click="RefreshPlayers_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Margin="0,0,5,0" Background="{DynamicResource RustConsoleBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                            <TextBox x:Name="RconLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A9B7C6" BorderThickness="0" FontFamily="Consolas" Padding="10"/>
                        </Border>
                        <Border Grid.Column="1" Margin="5,0,0,0" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                            <DataGrid x:Name="PlayersGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#1E1E1E">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="SteamID" Binding="{Binding SteamId}" Width="Auto"/>
                                    <DataGridTextColumn Header="Пинг" Binding="{Binding Ping}" Width="Auto"/>
                                    <DataGridTemplateColumn Header="Действия" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                    <ui:Button Content="Кик" Appearance="Primary" Background="#ffc107" Foreground="Black" Padding="10,5" Margin="0,0,5,0" Click="KickPlayer_Click"/>
                                                    <ui:Button Content="Бан" Appearance="Primary" Background="#dc3545" Foreground="Black" Padding="10,5" Click="BanPlayer_Click"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                        <ui:TextBox x:Name="TxtRconCommand" Width="850" Margin="0,0,10,0" KeyDown="TxtRconCommand_KeyDown"/>
                        <ui:Button Content="Отправить" Icon="{ui:SymbolIcon Send24}" Appearance="Primary" Width="150" Height="36" Click="SendRconCommand_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ВКЛАДКА: ПЛАГИНЫ -->
            <TabItem Header="Плагины">
                <TabControl x:Name="PluginsTabControl" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Установленные">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,10,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ui:Button Content="Открыть папку" Icon="{ui:SymbolIcon FolderOpen24}" Width="180" Height="36" Click="OpenPluginsFolder_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                                    <ui:Button Content="Обновить" Icon="{ui:SymbolIcon ArrowSync24}" Width="100" Height="36" Margin="10,0,0,0" Click="RefreshInstalledPlugins_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                                    <ListBox x:Name="InstalledPluginsList" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" SelectionChanged="InstalledPluginsList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="14" Margin="5"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ConfigHeader" Grid.Row="0" Text="Выберите плагин слева, чтобы загрузить его конфиг" FontWeight="SemiBold" Foreground="{DynamicResource RustOrange}" Margin="0,0,0,10"/>
                                <Border Grid.Row="1" Background="{DynamicResource RustConsoleBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                                    <TextBox x:Name="ConfigEditor" IsReadOnly="False" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" TextWrapping="Wrap" Background="Transparent" Foreground="#A9B7C6" BorderThickness="0" FontFamily="Consolas" Padding="10"/>
                                </Border>
                                <ui:Button x:Name="SaveConfigBtn" Grid.Row="2" Content="Сохранить конфиг" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Background="{DynamicResource RustOrange}" Foreground="Black" Width="200" Height="36" HorizontalAlignment="Right" Margin="0,10,0,0" Click="SavePluginConfig_Click"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Браузер uMod">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="10" Margin="0,0,0,10" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Скачать Oxide с GitHub" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Background="{DynamicResource RustOrange}" Foreground="Black" Width="280" Height="36" Click="DownloadOxide_Click" Margin="0,0,20,0"/>
                                    <TextBlock Text="Внимание: перед обновлением Oxide остановите сервер!" VerticalAlignment="Center" Foreground="#dc3545" FontStyle="Italic"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Padding="10" Margin="0,0,0,10" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBox x:Name="TxtPluginSearch" Width="400" PlaceholderText="Введите название плагина..." Margin="0,0,10,0" KeyDown="TxtPluginSearch_KeyDown"/>
                                    <ui:Button Content="Найти" Icon="{ui:SymbolIcon Search24}" Appearance="Primary" Background="{DynamicResource RustOrange}" Foreground="Black" Click="SearchPlugins_Click" Width="120" Margin="0,0,10,0"/>
                                    <ui:Button Content="Очистить" Click="ClearPluginSearch_Click" Background="{DynamicResource RustOrange}" Foreground="Black"/>
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Margin="0,0,0,10">
                                    <DataGrid x:Name="PluginsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" Background="Transparent" BorderThickness="0" RowBackground="Transparent" AlternatingRowBackground="#1E1E1E" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="Auto"/>
                                            <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="Auto"/>
                                            <DataGridTemplateColumn Header="Действие" Width="Auto">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ui:Button Content="Установить" Appearance="Primary" Background="{DynamicResource RustOrange}" Foreground="Black" Padding="10,5" Click="InstallPlugin_Click"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Border Grid.Row="1" Background="{DynamicResource RustConsoleBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                                    <TextBox x:Name="PluginLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A9B7C6" BorderThickness="0" FontFamily="Consolas" Padding="10"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ВКЛАДКА: ИНТЕРФЕЙС -->
            <TabItem Header="Интерфейс">
                <Grid Margin="10">
                    <Border Background="{DynamicResource RustPanelBg}" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="500">
                        <StackPanel>
                            <TextBlock Text="Зимнее оформление ❄️" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Добавляет падающий снег поверх интерфейса." Foreground="#AAAAAA" FontSize="14" Margin="0,0,0,20" TextWrapping="Wrap"/>
                            <ui:ToggleSwitch x:Name="WinterThemeToggle" Content="Включить снег" Checked="WinterTheme_Changed" Unchecked="WinterTheme_Changed" FontSize="16"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <Canvas x:Name="SnowCanvas" Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="99" Visibility="Collapsed"/>
    </Grid>
</ui:FluentWindow>
