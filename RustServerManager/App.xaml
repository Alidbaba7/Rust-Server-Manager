<Application x:Class="RustServerManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Подключаем темную тему и контролы -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- ЦВЕТА В СТИЛЕ RUST -->
            <SolidColorBrush x:Key="RustOrange" Color="#CE422B"/>
            <!-- Ржаво-оранжевый -->
            <SolidColorBrush x:Key="RustOrangeHover" Color="#E0543C"/>
            <SolidColorBrush x:Key="RustDarkBg" Color="#121212"/>
            <!-- Глубокий черный -->
            <SolidColorBrush x:Key="RustPanelBg" Color="#1A1A1A"/>
            <!-- Темно-серый для панелей -->
            <SolidColorBrush x:Key="RustConsoleBg" Color="#0A0A0A"/>
            <!-- Черный для консолей -->
            <SolidColorBrush x:Key="RustText" Color="#E0E0E0"/>
            <!-- Светло-серый текст -->
        </ResourceDictionary>
    </Application.Resources>
</Application>